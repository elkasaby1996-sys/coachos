          "itemRef": "synthetic/item/seat",
          "productRef": null,
          "quantity": 2,
          "unitAmountMinor": 1000
        }
      ]
    }
  },
  "transaction": {
    "schema": "billing-proof-v2",
    "validator": "paddle-contract-v1",
    "provider": "paddle",
    "environment": "test",
    "kind": "transaction",
    "source": "api_reconciliation",
    "evidenceClass": "verified_transaction",
    "identity": {
      "customerRef": "synthetic/customer",
      "subscriptionRef": "synthetic/subscription",
      "transactionRef": "synthetic/transaction"
    },
    "transactionEvidence": {
      "providerCreatedAt": "2026-09-01T10:00:00.000Z",
      "providerUpdatedAt": "2026-09-01T10:01:00.000Z",
      "providerStatus": "completed",
      "providerOrigin": "synthetic-recurring",
      "completedAt": "2026-09-01T10:00:30.000Z",
      "currency": "USD",
      "subtotalMinor": 6900,
      "taxMinor": 0,
      "discountMinor": 0,
      "totalMinor": 6900,
      "paidMinor": 6900,
      "balanceMinor": 0,
      "adjustmentRefs": [],
      "items": [
        {
          "priceRef": "synthetic/base",
          "itemRef": "synthetic/item/base",
          "productRef": null,
          "quantity": 1,
          "unitAmountMinor": 4900
        },
        {
          "priceRef": "synthetic/seat",
