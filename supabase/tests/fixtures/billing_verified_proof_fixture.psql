    },
    "subscriptionEvidence": {
      "providerCreatedAt": "2026-09-01T10:00:00.000Z",
      "providerUpdatedAt": "2026-09-01T10:01:00.000Z",
      "providerStatus": "active",
      "periodStartedAt": null,
      "periodEndsAt": null,
      "items": [
        {
          "priceRef": "synthetic/base",
          "itemRef": "synthetic/item/base",
          "productRef": null,
          "quantity": 1,
          "unitAmountMinor": 4900
        },
        {
