      "subscriptionRef": "synthetic/subscription",
      "transactionRef": "synthetic/transaction"
    },
    "eventEvidence": {
      "eventRef": "synthetic/event",
      "eventName": "transaction.paid",
      "resourceType": "transaction",
      "resourceRef": "synthetic/transaction",
      "occurredAt": "2026-09-01T10:01:00.000Z"
    }
  },
  "subscription": {
    "schema": "billing-proof-v2",
    "validator": "paddle-contract-v1",
    "provider": "paddle",
    "environment": "test",
