-- Synthetic normalized contract facts ONLY. Not Paddle wire samples or real IDs.
-- Shared by pgTAP and Vitest. No signature/authentication/settlement claim is made
-- about a real provider. The delimited value is the sole JSON fixture document.
create temp table proof_vectors(j jsonb);
insert into proof_vectors values($fixture${
  "event": {
    "schema": "billing-proof-v2",
    "validator": "paddle-contract-v1",
    "provider": "paddle",
    "environment": "test",
    "kind": "event",
    "source": "webhook",
