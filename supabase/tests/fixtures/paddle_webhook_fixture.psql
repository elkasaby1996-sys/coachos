-- Synthetic observations only; no provider calls or live references.
create function pg_temp.webhook_observation(k text default 'transaction.completed',e text default 'synthetic/event',n text default 'synthetic/delivery',stamp text default '2026-09-20T10:00:00.000Z') returns jsonb language sql as $$
select jsonb_build_object('provider','paddle','environment','test','kind',k,'eventType',k,'eventRef',e,'notificationRef',n,'occurredAt',stamp,'customerRef','synthetic/customer','subscriptionRef','synthetic/subscription','status',case when k='transaction.completed' then 'completed' else 'active' end,'items',jsonb_build_array(jsonb_build_object('priceRef','synthetic/price/growth/monthly','productRef','synthetic/product/growth','quantity',1,'unitPrice',jsonb_build_object('amount','5900','currency','USD')) || case when k='transaction.completed' then '{}'::jsonb else jsonb_build_object('status','active') end)) || case when k='transaction.completed' then jsonb_build_object('transactionRef','synthetic/transaction','currency','USD') else jsonb_build_object('transactionCorrelationRef',case when k='subscription.created' then 'synthetic/transaction' else null end) end $$;
create function pg_temp.webhook_ingest(o jsonb,raw text default null) returns jsonb language sql as $$
select public.ingest_verified_paddle_event_v1(jsonb_build_object('schema','billing-proof-v2','validator','paddle-contract-v1','provider',o->>'provider','environment',o->>'environment','kind','event','source','webhook','evidenceClass','authenticated_provider','identity',jsonb_build_object('customerRef',o->'customerRef','subscriptionRef',o->'subscriptionRef','transactionRef',case when o->>'kind'='transaction.completed' then o->'transactionRef' else 'null'::jsonb end),'eventEvidence',jsonb_build_object('eventRef',o->>'eventRef','eventName',o->>'eventType','resourceType',case when o->>'kind'='transaction.completed' then 'transaction' else 'subscription' end,'resourceRef',case when o->>'kind'='transaction.completed' then o->>'transactionRef' else o->>'subscriptionRef' end,'occurredAt',to_char((o->>'occurredAt')::timestamptz at time zone 'UTC','YYYY-MM-DD"T"HH24:MI:SS.MS"Z"'))),coalesce(raw,encode(extensions.digest(o::text,'sha256'),'hex')),o->>'notificationRef',o) $$;
