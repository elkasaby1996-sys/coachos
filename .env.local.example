VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MARKETING_SITE_URL=
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_RELEASE=local
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_TRACE_PROPAGATION_TARGETS=
VITE_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
VITE_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=
VITE_SENTRY_ENABLE_LOGS=true
VITE_SENTRY_CONSOLE_LOG_LEVELS=warn,error
VITE_SENTRY_ENABLE_METRICS=true

# Public Paddle.js settings. Server API keys and webhook secrets never belong here.
VITE_BILLING_PROVIDER=paddle
VITE_PADDLE_ENVIRONMENT=sandbox
VITE_PADDLE_SANDBOX_CLIENT_TOKEN=
# For a production build, select production above and set only the live token.
VITE_PADDLE_LIVE_CLIENT_TOKEN=
